{
  "name": "inventory-tracker",
  "version": "2.1.0",
  "description": "Per-brand variant stock tracker. Brand adapters scrape collections deterministically; a React web UI shows products, variants and stock status.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "legacy:crawler": "node index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "vite": "^6.0.7"
  },
  "optionalDependencies": {
    "playwright": "^1.58.2"
  }
}
